# Copy this file to `.env` and adjust as needed.
# All variables are optional; defaults are sensible for local development.

# Directory where the SQLite database is stored.
# ASSETLENS_DATA_DIR=data

# Full SQLAlchemy URL. When set, it overrides ASSETLENS_DATA_DIR.
# ASSETLENS_DATABASE_URL=sqlite:///data/assetlens.db
#
# PostgreSQL/Neon: use the pooled URL for the application and the direct URL
# for Alembic migrations. Plain postgresql:// URLs are normalized to psycopg 3.
# ASSETLENS_DATABASE_URL=postgresql+psycopg://user:password@host-pooler/db?sslmode=require
# ASSETLENS_MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@host/db?sslmode=require

# Watchlist file (provider + instrument definitions).
# ASSETLENS_INSTRUMENTS_FILE=config/instruments.yaml

# Policy snapshot file (premiums, holdings, valuation date).
# config/policy.yaml is committed with EXAMPLE data.
# Use a gitignored local file for real figures, then set:
# ASSETLENS_POLICY_FILE=config/policy.local.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR.
# ASSETLENS_LOG_LEVEL=INFO

# HTTP behaviour for providers.
# ASSETLENS_HTTP_TIMEOUT=20
# ASSETLENS_HTTP_USER_AGENT=assetlens/0.1.0 (+https://github.com/your-user/assetlens)
# ASSETLENS_REQUEST_DELAY_SECONDS=0.5
# ASSETLENS_MAX_RETRIES=4

# Number of days re-fetched on every incremental sync to catch corrections.
# ASSETLENS_OVERLAP_DAYS=5

# Earliest date used for a full backfill.
# ASSETLENS_BACKFILL_START=2000-01-01
