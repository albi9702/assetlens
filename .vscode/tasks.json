{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "shell",
      "command": "uv run ruff check src tests",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "uv run mypy src",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "sync",
      "type": "shell",
      "command": "uv run assetlens sync",
      "problemMatcher": []
    }
  ]
}
